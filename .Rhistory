#' Récupère les données fondamentales depuis EOD Historical Data
#'
#' @param ticker Le symbole boursier (ex: "AAPL.US", "NESN.SW")
#' @param apikey Ta clé API (chargée automatiquement depuis .Renviron si NULL)
#' @param verbose Affiche les noms des sections disponibles si TRUE
#'
#' @return Une liste contenant les blocs de données fondamentales (ex: General, Highlights, Valuation, etc.)
#' @export
get_fundamentals_eod <- function(ticker, apikey = NULL, verbose = TRUE) {
if (is.null(apikey)) {
apikey <- Sys.getenv("EOD_API_KEY")
}
if (apikey == "") {
stop("Clé API manquante. Assure-toi que EOD_API_KEY est défini dans .Renviron")
}
# Construction de l'URL
url <- paste0("https://eodhd.com/api/fundamentals/", ticker, "?api_token=", apikey, "&fmt=json")
# Requête API
response <- httr::GET(url)
if (httr::status_code(response) != 200) {
warning("Erreur API pour le ticker : ", ticker)
return(NULL)
}
content_raw <- httr::content(response, "text", encoding = "UTF-8")
data <- jsonlite::fromJSON(content_raw)
if (verbose) {
cat("✅ Sections disponibles pour", ticker, ":\n")
print(names(data))
}
return(data)
}
test <- get_fundamentals_eod(ticker = "AAPL",apikey = apikey)
test <- get_fundamentals_eod(ticker = "AAPL")
test <- get_fundamentals_eod(ticker = "AAPL.US")
